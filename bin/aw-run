#!/usr/bin/env python3
"""Run a workflow role on the CLI that owns its model, so each call bills that CLI's plan.

  aw-run --resolve ROLE              print the role's model(s) as JSON
  aw-run ROLE [options] < brief.md   run the brief headless and print the final message

Works with any mix of Claude Code, Codex, and Grok. A model whose CLI is not installed
resolves to the first installed model in its fallback chain.
"""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib

EFFORTS = ["low", "medium", "high", "xhigh", "max"]
BUDGETS = {"unlimited": "max", "large": "xhigh", "medium": "high", "small": "medium"}
LIMIT = re.compile(r"usage limit|rate limit|limit reached|quota|too many requests|\b429\b", re.I)
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "agent-workflows" / "models.toml"
CODEX_AGENTS = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "agents"
# The always-on workflow tells every session to run a playbook, so a child must hear it is the lead's delegate.
DELEGATE = ("You are the delegate of a lead session in another CLI, which started you through `aw-run` to do the task "
            "below and return the result. The lead owns the playbook, the todo list, and every subagent spawn. Do the task "
            "yourself. Do not spawn subagents, open a playbook todo list, or start a playbook.\n\n")
LOG = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "agent-workflows" / "runs.jsonl"
TURNS = LOG.with_name("pool-turns.json")


def json_or(text, default):
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return default


def last_usage(events):
    usage = None
    for line in events.splitlines():
        event = json_or(line, None)
        if isinstance(event, dict) and "usage" in event:
            usage = event["usage"]
    return usage


def claude_command(choice, read_only, cwd, files):
    model = ["--model", choice["model"]] if choice["model"] else []
    return ["claude", "-p", "--agent", choice["agent"], *model, "--effort", choice["effort"],
            "--permission-mode", "plan" if read_only else "auto", "--output-format", "json"]


def claude_parse(result, files):
    data = json_or(result.stdout, {"is_error": True, "result": result.stdout + result.stderr})
    failed = result.returncode != 0 or data.get("is_error", False)
    return data.get("result", ""), failed, {"usage": data.get("usage"), "cost_usd": data.get("total_cost_usd")}


def codex_command(choice, read_only, cwd, files):
    tier = ["-c", 'service_tier="priority"'] if choice["speed"] == "fast" else []
    network = [] if read_only else ["-c", "sandbox_workspace_write.network_access=true"]
    sandbox = ["-s", "read-only"] if read_only else ["--approve-for-me"]
    return ["codex", "exec", "-m", choice["model"], "-c", f'model_reasoning_effort="{choice["effort"]}"', *tier,
            *sandbox, *network, "-C", str(cwd), "--skip-git-repo-check", "--json",
            "-o", files["message"]]


def delegate_brief(brief, agent):
    return DELEGATE + brief


def codex_brief(brief, agent):
    # `codex exec` cannot select an agent, and Codex labels every session `/root`.
    path = CODEX_AGENTS / f"{agent}.toml"
    if not path.is_file():
        sys.exit(f"aw-run: no {agent} agent at {path}; run `aw install --runtime codex`")
    instructions = tomllib.loads(path.read_text())["developer_instructions"]
    return DELEGATE.replace("You are", "Codex labels every session `/root`, but you are", 1) + instructions + "\n---\n\n" + brief


def codex_parse(result, files):
    return Path(files["message"]).read_text(), result.returncode != 0, {"usage": last_usage(result.stdout)}


def grok_command(choice, read_only, cwd, files):
    # Grok's headless mode does not read stdin, so the brief goes through --prompt-file.
    return ["grok", "--prompt-file", files["prompt"], "--agent", choice["agent"], "-m", choice["model"], "--effort", choice["effort"],
            "--sandbox", "read-only" if read_only else "workspace",
            "--permission-mode", "dontAsk" if read_only else "auto",
            "--cwd", str(cwd), "--output-format", "json"]


def grok_parse(result, files):
    data = json_or(result.stdout, {"type": "error", "message": result.stdout + result.stderr})
    failed = result.returncode != 0 or data.get("type") == "error"
    text = data.get("message", "") if data.get("type") == "error" else data.get("text", "")
    return text, failed, {"usage": data.get("usage"), "cost_usd": data.get("total_cost_usd")}


PROVIDERS = {
    "claude": {"binary": "claude", "command": claude_command, "parse": claude_parse, "stdin": True, "brief": delegate_brief},
    "codex": {"binary": "codex", "command": codex_command, "parse": codex_parse, "stdin": True, "brief": codex_brief,
              "fast": True},
    "grok": {"binary": "grok", "command": grok_command, "parse": grok_parse, "stdin": False, "brief": delegate_brief},
}


def installed(provider):
    return shutil.which(PROVIDERS[provider]["binary"]) is not None


def load():
    path = Path(os.environ.get("AW_MODELS", CONFIG))
    if not path.is_file():
        sys.exit(f"aw-run: no model registry at {path}")
    registry = tomllib.loads(path.read_text())
    if registry.get("budget", "large") not in BUDGETS:
        sys.exit(f"aw-run: budget must be one of {', '.join(BUDGETS)}")
    for name, entry in registry.get("models", {}).items():
        if entry.get("provider") not in PROVIDERS:
            sys.exit(f"aw-run: model {name!r} needs provider = one of {', '.join(PROVIDERS)}")
    return registry


def chain(registry, name):
    """The model, then its fallbacks breadth-first, each once."""
    order, queue = [], [name]
    while queue:
        current = queue.pop(0)
        if current in order:
            continue
        if current not in registry.get("models", {}):
            sys.exit(f"aw-run: unknown model {current!r}")
        order.append(current)
        fallback = registry["models"][current].get("fallback", [])
        queue.extend(fallback if isinstance(fallback, list) else [fallback])
    return order


def parse_seat(registry, role, value):
    """A role entry is `model`, `model:effort`, or `model:effort:fast`; effort defaults to the budget's."""
    name, *rest = value.split(":")
    effort = rest[0] if rest else BUDGETS[registry.get("budget", "large")]
    speed = rest[1] if len(rest) > 1 else "standard"
    if effort not in EFFORTS or speed not in ("standard", "fast") or len(rest) > 2:
        sys.exit(f"aw-run: role {role!r} entry {value!r} must be model[:{'|'.join(EFFORTS)}][:fast]")
    if name != "inherit" and name not in registry.get("models", {}):
        sys.exit(f"aw-run: role {role!r} names unknown model {name!r}")
    if speed == "fast" and name != "inherit" and not PROVIDERS[registry["models"][name]["provider"]].get("fast"):
        sys.exit(f"aw-run: role {role!r} entry {value!r}: only Codex models have a fast tier")
    return name, effort, speed


def resolve(registry, role, shift):
    """The role's seats, and whether they are a pool whose entries take turns."""
    if role not in registry.get("roles", {}):
        sys.exit(f"aw-run: unknown role {role!r}; roles: {', '.join(registry.get('roles', {}))}")
    value = registry["roles"][role]
    pool = isinstance(value, dict)
    if pool and (set(value) != {"pool"} or not isinstance(value["pool"], list) or not value["pool"]):
        sys.exit(f"aw-run: role {role!r} table must be {{ pool = [entry, ...] }}")
    seats = []
    for entry in value["pool"] if pool else value if isinstance(value, list) else [value]:
        name, effort, speed = parse_seat(registry, role, entry)
        if pool and name == "inherit":
            sys.exit(f"aw-run: role {role!r} pool cannot hold inherit, because every pool turn runs through aw-run")
        effort = EFFORTS[min(max(EFFORTS.index(effort) + shift, 0), len(EFFORTS) - 1)]
        if name == "inherit":
            seats.append({"name": "inherit", "provider": "inherit", "model": None, "effort": None})
            continue
        available = [model for model in chain(registry, name) if installed(registry["models"][model]["provider"])]
        if not available:
            sys.exit(f"aw-run: no installed CLI for model {name!r} or its fallbacks")
        entry = registry["models"][available[0]]
        seat = {"name": available[0], "provider": entry["provider"], "model": entry["model"], "effort": effort,
                "speed": speed if PROVIDERS[entry["provider"]].get("fast") else "standard", "fallbacks": available[1:]}
        if available[0] != name:
            seat["substituted_for"] = name
        seats.append(seat)
    return seats, pool


def take_turn(role, size):
    """The pool entry this run takes. The lock gives parallel launches distinct turns."""
    TURNS.parent.mkdir(parents=True, exist_ok=True)
    with TURNS.open("a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        handle.seek(0)
        turns = json_or(handle.read(), {})
        turn = turns.get(role, 0)
        turns[role] = turn + 1
        handle.seek(0)
        handle.truncate()
        handle.write(json.dumps(turns))
    return turn % size


def run(choice, brief, read_only, cwd):
    provider = PROVIDERS[choice["provider"]]
    brief = provider["brief"](brief, choice["agent"])
    with tempfile.TemporaryDirectory(prefix="aw-run-") as scratch:
        files = {"message": str(Path(scratch) / "message.md"), "prompt": str(Path(scratch) / "prompt.md")}
        Path(files["message"]).touch()
        Path(files["prompt"]).write_text(brief)
        started = time.monotonic()
        result = subprocess.run(provider["command"](choice, read_only, cwd, files),
                                input=brief if provider["stdin"] else None,
                                stdin=None if provider["stdin"] else subprocess.DEVNULL,
                                capture_output=True, text=True, cwd=cwd)
        text, failed, details = provider["parse"](result, files)
    limited = failed and bool(LIMIT.search(text + result.stdout + result.stderr))
    outcome = {"exit": result.returncode, "seconds": round(time.monotonic() - started, 1), **details}
    return (text or result.stderr) if failed else text, failed, limited, outcome


def log(entry):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as handle:
        handle.write(json.dumps(entry) + "\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("role")
    parser.add_argument("--resolve", action="store_true", help="print the resolved model(s) and exit")
    parser.add_argument("--index", type=int, help="panel seat to run, for list roles")
    parser.add_argument("--shift", type=int, default=0, help="effort steps from the budget level, e.g. -2 or 1")
    parser.add_argument("--read-only", action="store_true", help="run in the CLI's read-only sandbox or plan mode")
    parser.add_argument("--cd", type=Path, default=Path.cwd(), help="working directory for the run")
    parser.add_argument("--out", type=Path, help="also write the final message here")
    parser.add_argument("--agent", default="delegate", help="installed agent the child runs as")
    parser.add_argument("--no-fallback", action="store_true", help="fail instead of switching to a fallback")
    args = parser.parse_args()
    registry = load()
    seats, pool = resolve(registry, args.role, args.shift)
    if args.resolve:
        print(json.dumps({"pool": seats} if pool else seats if len(seats) > 1 else seats[0]))
        return
    if pool and args.index is not None:
        sys.exit(f"aw-run: role {args.role!r} is a pool whose entries take turns; drop --index")
    index = args.index or 0
    if not 0 <= index < len(seats):
        sys.exit(f"aw-run: role {args.role!r} has {len(seats)} seat(s)")
    if seats[index]["provider"] == "inherit" and not os.environ.get("CLAUDECODE"):
        sys.exit("aw-run: this role inherits the parent model; spawn a native subagent instead")
    brief = sys.stdin.read()
    if not brief.strip():
        sys.exit("aw-run: pass the brief on stdin")
    if pool:
        index = take_turn(args.role, len(seats))
    seat = seats[index]
    if seat["provider"] == "inherit":
        # Claude Code has no Agent tool, so an inherit seat runs headless on its default model at the session's effort.
        effort = os.environ.get("CLAUDE_EFFORT")
        effort = effort if effort in EFFORTS else BUDGETS[registry.get("budget", "large")]
        seat = {**seat, "provider": "claude", "effort": EFFORTS[min(max(EFFORTS.index(effort) + args.shift, 0), 4)],
                "speed": "standard", "fallbacks": []}
    attempts = [seat["name"]] + ([] if args.no_fallback else seat["fallbacks"])
    for attempt, name in enumerate(attempts):
        entry = seat if name == "inherit" else registry["models"][name]
        fast = seat["speed"] == "fast" and PROVIDERS[entry["provider"]].get("fast")
        choice = {"provider": entry["provider"], "model": entry["model"], "effort": seat["effort"],
                  "speed": "fast" if fast else "standard", "agent": args.agent}
        text, failed, limited, outcome = run(choice, brief, args.read_only, args.cd)
        log({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "role": args.role, "seat": index, "model_name": name,
             **choice, "read_only": args.read_only, "limited": limited, **({"pool": True} if pool else {}),
             **({"fallback_from": attempts[attempt - 1]} if attempt else {}), **outcome})
        if not limited or attempt == len(attempts) - 1:
            break
        following = registry["models"][attempts[attempt + 1]]
        print(f"aw-run: {entry['provider']} hit a usage limit; retrying on {following['provider']} "
              f"{following['model']}", file=sys.stderr)
    if args.out:
        args.out.write_text(text)
    print(text)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
