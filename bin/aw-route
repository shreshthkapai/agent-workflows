#!/usr/bin/env python3
"""Claude Code PreToolUse hook that routes workflow subagents to the provider their role names.

A native `delegate`, `general-purpose`, or `comment-sicko` spawn must open its brief with `Role: <role>`,
plus `Seat: <n>` for a panel seat, or `Role: none` when its skill picks the model. A seat on Claude, or
`inherit`, spawns natively. A seat on another provider is denied with the `aw-run` command to run instead.
Any failure of this hook lets the spawn through.
"""

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

ROUTED = {"delegate", "general-purpose", "comment-sicko"}
ROLE = re.compile(r"^\s*Role:\s*`?([\w-]+)`?\s*$", re.M)
SEAT = re.compile(r"^\s*Seat:\s*(\d+)\s*$", re.M)


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    sys.exit(0)


def aw_run():
    sibling = Path(__file__).resolve().parent / "aw-run"
    return str(sibling) if sibling.is_file() else shutil.which("aw-run")


def main():
    if os.environ.get("CLAUDE_CODE_DISABLE_CLAUDE_MDS"):  # claude-lite runs without the workflow.
        return
    tool_input = json.load(sys.stdin).get("tool_input", {})
    agent = tool_input.get("subagent_type") or "general-purpose"
    if agent not in ROUTED:
        return
    head = "\n".join(tool_input.get("prompt", "").splitlines()[:5])
    role = ROLE.search(head)
    if not role:
        deny(f"Open the brief with a `Role: <role>` line naming the models.toml role this {agent} fills, and a "
             "`Seat: <n>` line for a panel seat, or `Role: none` when no role covers it and its skill picks the model, per the "
             "Subagents section of the workflow skill. Then spawn again.")
    role = role.group(1)
    if role == "none":
        return
    resolved = subprocess.run([aw_run(), "--resolve", role], capture_output=True, text=True, timeout=8)
    if resolved.returncode:
        if "unknown role" in resolved.stderr:
            deny(resolved.stderr.strip())
        return
    seats = json.loads(resolved.stdout)
    panel = isinstance(seats, list)
    seats = seats if panel else [seats]
    seat = SEAT.search(head)
    index = int(seat.group(1)) if seat else 0
    if index >= len(seats):
        deny(f"Role {role} has {len(seats)} seat(s). Set `Seat:` to 0 through {len(seats) - 1}.")
    if seats[index]["provider"] in ("claude", "inherit"):
        return
    flags = (f" --index {index}" if panel else "") + (" --agent comment-sicko" if agent == "comment-sicko" else "")
    deny(f"Role {role}{f' seat {index}' if panel else ''} runs on {seats[index]['provider']} "
         f"{seats[index]['model']}, so do not spawn it here. Write the brief to a file and run "
         f"`aw-run {role}{flags} --out <result file> < <brief file>` as a background shell job, adding --read-only "
         "for a read-only step and --shift for an effort change. Read the result file when the job exits.")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
