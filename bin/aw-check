#!/usr/bin/env python3
"""Point an agent at the written sources its work rests on, so it reads them instead of working from memory.

Runs as a UserPromptSubmit hook on each new message, and as `aw-check --review BRIEF REPORT`, which `aw-run` calls
when a delegate finishes. A small model on the `source_check` role picks the sources from the session's history,
the recent conversation, and the message, without reading them. The agent gets the list: read these, then carry
on, or review against them. Any error lets the message through unchanged.
"""

import json
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import tomllib

EARLIER_CHARS = 12000
MESSAGE_CHARS = 10000
SYSTEM = "You point a coding agent at the files it should read. Reply with JSON only."
SOURCES = """A written source is anything the work rests on that exists in writing: a file, doc, note, design, \
mockup, spec, plan, artifact, log, or test output. Something only said in the conversation is not a source.

The agent is working in {project}. List the written sources that doing the user's NEW MESSAGE correctly requires \
reading. A source from another project counts only when the new message is about that project. Most messages need \
none: a short reply, thanks, a yes or no, a request to restate or explain what was said, or a question the \
conversation already answers. When unsure, list none. Choose only from what you are given here, without running \
commands or opening files. Give each as the path or URL exactly as written there, with a few words on what it \
covers. Reply {"sources": ["<path or URL>: <what it covers>"]}, or {"sources": []}.

EVERYTHING THIS SESSION TOUCHED, most recent first:
{touched}

EARLIER CONVERSATION, most recent part:
{earlier}

NEW MESSAGE:
{message}
"""

# The tool-input fields that name a file, note, page, or skill. A Codex patch names its files in its header lines.
# Shell commands and tool output name files and pages only in their text, so links and paths are read off it.
NAMED = ("file_path", "notebook_path", "path", "url", "from_url", "skill")
PATCHED = ("*** Add File: ", "*** Update File: ", "*** Delete File: ")
LINK = re.compile(r"https?://[^\s\"'<>()\[\]`]+")
# A path counts only where it starts a word, so `$D/page.html` yields nothing rather than a broken `/page.html`.
FILE = re.compile(r"(?:(?<=[\s'\"=(:>,|;])|^)~?/[\w.@%+-]+(?:/[\w.@%+-]+)+")


def rows(path):
    with open(path) as handle:
        for line in handle:
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def text_of(parts):
    return "\n".join(part.get("text", "") for part in parts if isinstance(part, dict) and "text" in part)


def touched(path):
    """Every file, note, page, and skill the session named, most recent first, each once."""
    names = []
    for row in rows(path):
        names += [link.rstrip(".,;:!?") for link in
                  LINK.findall(json.dumps(row.get("message") or row.get("payload") or {}).replace("\\n", " "))]
        calls = [part.get("input") for part in ((row.get("message") or {}).get("content") or [])
                 if isinstance(part, dict) and part.get("type") == "tool_use"]
        item = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        if item.get("type") in ("function_call", "custom_tool_call"):
            raw = item.get("arguments") or item.get("input") or ""
            try:
                calls.append(json.loads(raw))
            except (TypeError, json.JSONDecodeError):
                names += [line.split(": ", 1)[1].strip() for line in str(raw).splitlines() if line.startswith(PATCHED)]
        for call in calls:
            if isinstance(call, dict):
                names += [str(call[key]) for key in NAMED if isinstance(call.get(key), str) and call[key]]
                command = str(call.get("command") or call.get("cmd") or "")
                names += FILE.findall(command.replace("${HOME}", "~").replace("$HOME", "~"))
    return list(dict.fromkeys(reversed(names)))


def claude_events(path):
    for row in rows(path):
        content = (row.get("message") or {}).get("content")
        if row.get("type") == "user" and not row.get("isMeta"):
            if isinstance(content, str):
                text = content
            elif any(isinstance(part, dict) and part.get("type") == "tool_result" for part in content or []):
                continue
            else:
                text = text_of(content or [])
            if text.strip():
                yield "user", text
        elif row.get("type") == "assistant" and isinstance(content, list):
            for part in content:
                if part.get("type") == "text":
                    yield "assistant", part["text"]
                elif part.get("type") == "tool_use":
                    yield "tool", f"{part.get('name')} {json.dumps(part.get('input'))[:400]}"


def codex_events(path):
    for row in rows(path):
        item = row.get("payload") or {}
        if row.get("type") != "response_item" or not isinstance(item, dict):
            continue
        if item.get("type") == "message" and item.get("role") in ("user", "assistant"):
            text = text_of(item.get("content") or [])
            # Codex sends its instruction files and environment as user messages before the person's own.
            if item["role"] == "user" and text.lstrip().startswith(("# AGENTS.md", "<environment_context", "<user_instructions")):
                continue
            if text.strip():
                yield item["role"], text
        elif item.get("type") in ("function_call", "custom_tool_call", "local_shell_call"):
            yield "tool", f"{item.get('name')} {str(item.get('arguments') or item.get('input') or item.get('action'))[:400]}"


def ask(provider, model, effort, prompt):
    env = {**os.environ, "AW_CHECKING": "1"}
    if provider == "claude":
        command = ["claude", "-p", "--setting-sources", "", "--model", model, "--tools", "", "--strict-mcp-config",
                   "--no-session-persistence", "--system-prompt", SYSTEM]
        return subprocess.run(command, input=prompt, capture_output=True, text=True, env=env, timeout=40).stdout
    if provider == "codex":
        with tempfile.NamedTemporaryFile("r", suffix=".md") as out:
            subprocess.run(["codex", "exec", "-m", model, "-s", "read-only", "--skip-git-repo-check",
                            "-c", f'model_reasoning_effort="{effort}"', "-o", out.name, "-"],
                           input=SYSTEM + "\n\n" + prompt, capture_output=True, text=True, env=env, timeout=40)
            return Path(out.name).read_text()
    return ""


def judge(prompt):
    """The `source_check` model's answer, trying its fallbacks in turn when a model gives none."""
    seat = json.loads(subprocess.run(["aw-run", "--resolve", "source_check"], capture_output=True, text=True,
                                     check=True).stdout)
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "agent-workflows" / "models.toml"
    models = tomllib.loads(Path(os.environ.get("AW_MODELS", config)).read_text()).get("models", {})
    for name in [seat["name"], *seat.get("fallbacks", [])]:
        entry = {"provider": seat["provider"], "model": seat["model"]} if name == seat["name"] else models.get(name, {})
        if not shutil.which(str(entry.get("provider"))):
            continue
        try:
            reply = ask(entry["provider"], entry["model"], seat["effort"], prompt)
        except subprocess.TimeoutExpired:
            continue
        start, end = reply.find("{"), reply.rfind("}")
        try:
            found = json.loads(reply[start:end + 1]) if start >= 0 else None
        except json.JSONDecodeError:
            found = None
        if isinstance(found, dict) and isinstance(found.get("sources"), list):
            return found
    return {}


def real(source, names):
    """The source with its path made whole, or None unless it is a link from the session or a file on disk."""
    name, _, about = str(source).partition(": ")
    name = name.strip().strip("`")
    if name.startswith(("http://", "https://")):
        return str(source) if name in names else None
    # The model sometimes drops the start of a long path, so match it to the end of one the session touched.
    tail = "/" + name.lstrip("/~")
    whole = name if name in names else next((touched_name for touched_name in names if touched_name.endswith(tail)), name)
    if "/" not in name or not Path(os.path.expanduser(whole)).exists():
        return None
    return f"{whole}: {about}" if about else whole


def named_in(text):
    """Links and paths written in free text, such as a message, a brief, or a delegate's report."""
    text = text.replace("${HOME}", "~").replace("$HOME", "~")
    return [link.rstrip(".,;:!?") for link in LINK.findall(text)] + FILE.findall(text)


def point(history, message, project):
    """The written sources a message rests on, from the session history when there is one and the message itself."""
    events = list((codex_events if "/.codex/" in history else claude_events)(history)) if history else []
    names = list(dict.fromkeys(named_in(message) + (touched(history) if history else [])))
    parts = {"project": project, "touched": "\n".join(names),
             "earlier": "\n".join(f"[{kind}] {text}" for kind, text in events)[-EARLIER_CHARS:],
             "message": message[:MESSAGE_CHARS]}
    found = judge(re.sub(r"\{(project|touched|earlier|message)\}", lambda match: parts[match.group(1)], SOURCES))
    return [source for source in (real(source, names) for source in found.get("sources") or []) if source]


def lead_history():
    """The history file of the Claude Code session that started this command, when there is one."""
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    found = list((Path.home() / ".claude" / "projects").glob(f"*/{session}.jsonl")) if session else []
    return str(found[0]) if found else None


def main():
    if os.environ.get("AW_CHECKING"):
        return
    if sys.argv[1:2] == ["--review"]:
        brief, report = (Path(name).read_text() for name in sys.argv[2:4])
        message = (f"The agent is about to review work a delegate finished. List the written sources the work must "
                   f"be compared against.\n\nBRIEF:\n{brief}\n\nDELEGATE'S REPORT:\n{report}")
        sources = point(lead_history(), message, os.getcwd())
        if sources:
            print("Read these first, then review the work against them: " + "; ".join(sources))
        return
    hook = json.load(sys.stdin)
    path = hook.get("transcript_path")
    sources = point(path if path and Path(path).is_file() else None, str(hook.get("prompt", "")),
                    str(hook.get("cwd") or os.getcwd()))
    if sources:
        context = "Read these first, then carry on: " + "; ".join(sources)
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": context}}))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
